# Copia este archivo a .env y rellena los valores.
# El archivo .env NO se sube a git — está en .gitignore.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=viajes

# Clave con la que se firman los tokens de sesión.
# Genera una nueva con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto de la API y origen del sitio web que puede llamarla.
PORT=3000
ORIGEN_PERMITIDO=http://localhost:5500
